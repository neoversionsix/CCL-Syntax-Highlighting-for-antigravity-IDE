{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Cerner CCL",
    "scopeName": "source.ccl",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#directives"
        },
        {
            "include": "#member-access"
        },
        {
            "include": "#declarations"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#types"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#variables"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.semicolon.ccl",
                    "match": ";.*$"
                },
                {
                    "name": "comment.line.exclamation.ccl",
                    "match": "!(?!=).*$"
                },
                {
                    "name": "comment.block.ccl",
                    "begin": "/\\*",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.comment.ccl"
                        }
                    },
                    "end": "\\*/",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.comment.ccl"
                        }
                    }
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.ccl",
                    "begin": "\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.ccl"
                        }
                    },
                    "end": "\"",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.ccl"
                        }
                    }
                },
                {
                    "name": "string.quoted.single.ccl",
                    "begin": "'",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.ccl"
                        }
                    },
                    "end": "'",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.ccl"
                        }
                    }
                },
                {
                    "name": "string.quoted.other.caret.ccl",
                    "begin": "\\^",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.ccl"
                        }
                    },
                    "end": "\\^",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.ccl"
                        }
                    }
                },
                {
                    "name": "string.quoted.other.tilde.ccl",
                    "begin": "~",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.ccl"
                        }
                    },
                    "end": "~",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.ccl"
                        }
                    }
                }
            ]
        },
        "directives": {
            "patterns": [
                {
                    "match": "(?i)^\\s*(%#?[a-z]+)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.directive.ccl"
                        }
                    }
                }
            ]
        },
        "member-access": {
            "patterns": [
                {
                    "match": "(->)\\s*([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "punctuation.accessor.ccl"
                        },
                        "2": {
                            "name": "variable.other.property.ccl"
                        }
                    }
                },
                {
                    "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "punctuation.accessor.ccl"
                        },
                        "2": {
                            "name": "variable.other.property.ccl"
                        }
                    }
                }
            ]
        },
        "declarations": {
            "patterns": [
                {
                    "match": "(?i)\\b(subroutine)\\s+(?:\\(\\s*)?([a-z_][a-z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "keyword.control.ccl"
                        },
                        "2": {
                            "name": "entity.name.function.ccl"
                        }
                    }
                },
                {
                    "match": "(?i)\\b(drop\\s+program|create\\s+program)\\s+([a-z_][a-z0-9_]*(?::[a-z_][a-z0-9_]*)?)",
                    "captures": {
                        "1": {
                            "name": "keyword.control.ccl"
                        },
                        "2": {
                            "name": "entity.name.type.ccl"
                        }
                    }
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.ccl",
                    "match": "(?i)\\b(CREATE\\s+PROGRAM|PERSISTSCRIPT|DROP\\s+PROGRAM|FOOT\\s+REPORT|FREE\\s+DEFINE|FREE\\s+RECORD|HEAD\\s+REPORT|NOCONSTANT|SKIPREPORT|SUBROUTINE|ENDSELECT|FOOT\\s+PAGE|HEAD\\s+PAGE|NOCOUNTER|OUTERJOIN|SEPARATOR|CONSTANT|CONTINUE|DISTINCT|DONTJOIN|DONTWAIT|ENDWHILE|FREE\\s+SET|GROUP\\s+BY|ORDER\\s+BY|ROLLBACK|COUNTER|DECLARE|ELSE\\s+IF|ENDCASE|EXECUTE|FOOTING|HEADING|MAXQUAL|PERSIST|PRIVATE|PROGRAM|PROTECT|CANCEL|COMMIT|CREATE|DEFINE|DELETE|DETAIL|ELSEIF|END\\s+GO|ENDFOR|HAVING|INSERT|MAXREC|MODIFY|NOTRIM|PROMPT|PUBLIC|RECORD|REMOVE|REPORT|RETURN|SELECT|UPDATE|VALUES|ALTER|BEGIN|BREAK|CHECK|CLASS|ENDGO|ENDIF|GO\\s+TO|INDEX|TABLE|UNION|WHERE|WHILE|CALL|CASE|DESC|DROP|ELSE|EXIT|FOOT|FREE|FROM|GOTO|HEAD|INTO|JOIN|PAGE|PLAN|STEP|THEN|TIME|VIEW|WITH|ASC|END|FOR|MAP|SET|BY|DO|GO|IF|OF|ON|TO)\\b"
                },
                {
                    "name": "keyword.control.ccl",
                    "match": "(?i)\\bFORMAT\\b(?!\\s*\\()"
                },
                {
                    "name": "keyword.operator.logical.ccl",
                    "match": "(?i)\\b(OPERATOR|BETWEEN|EXISTS|LIKE|AND|NOT|AS|IN|IS|OR)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.ccl",
                    "match": "(?i)\\b(CURTIMEZONEAPP|CURCODECOVER|SYSTIMESTAMP|CURACCEPT|CURDOMAIN|CURLOCALE|CURALIAS|CURSCOPE|CURTIME2|CURTIME3|CURDATE|CURFILE|CURHELP|CURPROG|CURQUAL|CURSYS2|CURTIME|CURUSER|SYSDATE|CURLOB|CURMEM|CURREV|CURSUB|CURSYS|CURUTC|OUTDEV|FALSE|NULL|TRUE|ZERO)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "match": "(?i)(=)\\s*((?:c|vc|gc|gvc|zc|zvc|zgc|zgvc)[1-9]\\d*)\\b(?!\\s*(?:\\.|->|\\(|\\[))",
                    "captures": {
                        "1": {
                            "name": "keyword.operator.ccl"
                        },
                        "2": {
                            "name": "storage.type.ccl"
                        }
                    }
                },
                {
                    "name": "storage.type.ccl",
                    "match": "(?i)\\b(f4|f8|i1|ui1|i2|ui2|i4|ui4|w8|uw8|dq8|dm12|dm14|vc|gvc|zvc|zgvc)\\b(?!\\s*(?:\\.|->|\\())"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "support.function.ccl",
                    "match": "(?i)\\buar_[a-z0-9_]+\\b(?=\\s*\\()"
                },
                {
                    "name": "support.function.ccl",
                    "match": "(?i)\\b(CCLNEWSESSIONWINDOW|DATETIMEZONEBYINDEX|DATEDECEASEDFORMAT|DATETIMEZONEBYNAME|DATETIMEZONEFORMAT|CNVTDATETIMEUTC2|CNVTDATETIMEUTC3|MPAGES_SVC_EVENT|CNVTAGEDATETIME|CNVTDATETIMERDB|CNVTDATETIMEUTC|DATEBIRTHFORMAT|DATETIMEZONEUTC|PERCENTILE_CONT|PERCENTILE_DISC|AESDECRYPTFILE|AESENCRYPTFILE|CNVTLOOKBEHIND|DATETIMECMPUTC|CNVTDATETIME2|CNVTJSONTOREC|CNVTLOOKAHEAD|CNVTRECTOJSON|CNVTSTRINGCHK|CNVTTIMESTAMP|DATETIMETRUNC|LOCATEVALSORT|REGEXPREPLACE|TIMESTAMPDIFF|CCLLINKPOPUP|CNVTALPHANUM|CNVTDATETIME|CNVTRECTOXML|CNVTXMLTOREC|DATETIMEDIFF|DATETIMEFIND|DATETIMEPART|DATETIMEZONE|MPAGES_EVENT|PERCENT_RANK|REGEXPSUBSTR|CNVTNLSSORT|DATETIMEADD|DATETIMECMP|DATETIMESUB|MOVERECLIST|NOPATSTRING|RECTRAVERSE|REGEXPCOUNT|REGEXPINSTR|REGEXPMATCH|SQLPASSTHRU|AESDECRYPT|AESENCRYPT|ARRAYSPLIT|BLOBGETLEN|CHECKQUEUE|CNVTB10B16|CNVTB10B36|CNVTB16B10|CNVTB36B10|CNVTHEXRAW|CNVTRAWHEX|CNVTSTRING|DENSE_RANK|ECHORECORD|FILLSTRING|FINDSTRING|MEMREALLOC|MOVESTRING|PARAMETER2|PERCENTILE|PRINTIMAGE|REPORTINFO|ROW_NUMBER|SCROLLDOWN|SCROLLINIT|SCROLLTEXT|SORTSEARCH|TDBEXECUTE|WTMODCHECK|ALTERLIST|ARRAYJOIN|BUILD2CHK|CCLREGEXP|CNVTALIAS|CNVTDATE2|CNVTLOWER|CNVTPHONE|CNVTTIME2|CNVTTIME3|CNVTUPPER|CUME_DIST|EVALUATE2|INITARRAY|ISNUMERIC|LOCATEVAL|NORDBBIND|NULLCHECK|PARAMETER|PATSTRING|PRINTFILE|PRINTTEXT|PROXYUSER|RENAMEREC|REPORTROW|SUBSTRING|CCLEVENT|CCLTIMER|CHECKDIC|CHECKFUN|CHECKPRG|CNVTAGE2|CNVTBOOL|CNVTDATE|CNVTLONG|CNVTMIN2|CNVTREAL|CNVTTIME|ECHOJSON|EVALUATE|FINDFILE|GREATEST|MEMALLOC|MODCHECK|NULLTERM|SCROLLUP|TRIMBIND|VALIDATE|VARIANCE|APPLINK|ASSIGN2|ASSIGN3|BLOBGET|CALCPOS|CALLPRG|CCLLINK|CNVTACC|CNVTAGE|CNVTCAP|CNVTINT|CNVTMIN|CNVTNLS|COMPILE|COPYREC|ECHOXML|INITREC|LISTAGG|LOGICAL|MEMFREE|MOVEREC|NULLFMT|NULLIND|NULLVAL|PERCENT|RDBBIND|REFLECT|REPLACE|SOUNDEX|TEXTLEN|WEEKDAY|ACCEPT|ALTER2|ALTER3|ASSIGN|BSHIFT|BUILD2|BUILD3|CCLFMT|CENTER|CONCAT|DECODE|EXPAND|FORMAT|JULIAN|MAXVAL|MEDIAN|MINUTE|MINVAL|NEGATE|PARSER|ROLLUP|STDDEV|BTEST|BUILD|CALLR|CCLIO|CLEAR|COUNT|DEBUG|ERROR|FLOOR|ICHAR|LEAST|LOG10|MONTH|NTILE|PAUSE|PIECE|PRINT|ROUND|SOUND|TRACE|VALUE|VIDEO|ASIS|BAND|BNOT|BXOR|CEIL|CHAR|COST|CUBE|ECHO|EDIT|EVEN|HOUR|LINE|LIST|RAND|RANK|SIZE|SORT|TEXT|TRIM|YEAR|ABS|AVG|BOR|BOX|COL|DAY|DCL|EXP|LOG|MAX|MIN|MOD|ROW|SEQ|SUM)\\b(?=\\s*\\()"
                },
                {
                    "match": "(?i)\\b([a-z_][a-z0-9_]*)(?=\\s*\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.ccl"
                        }
                    }
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.ccl",
                    "match": "(->|!=|<>|<=|>=|\\*\\*|[=<>+\\-*/])"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.ccl",
                    "match": "\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b|(?<!\\w)\\.\\d+(?:[eE][+-]?\\d+)?\\b"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "variable.other.ccl",
                    "match": "(?i)\\b[a-z_][a-z0-9_]*\\b"
                }
            ]
        }
    }
}
